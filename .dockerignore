# Build context stays small and cannot pick up local secrets.
# Public configuration is passed with --build-arg, not by copying env files.

Dockerfile
.dockerignore
.git
.github
.cursor
.vscode
.idea
.vercel
node_modules
.next
out
build
coverage
docs
__tests__
*.md
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem
*.tsbuildinfo

# Never send credentials into the build context.
.env
.env.*
!.env.example
