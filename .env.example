# Copy to .env.local and fill in. Never commit real keys.

# Finnhub key for the FX feed (browser-exposed; use a restricted key).
NEXT_PUBLIC_FINNHUB_API_KEY=

# Public URL of the deployment, used for canonical links and absolute
# Open Graph / Twitter image URLs. Optional on Vercel (detected automatically).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
